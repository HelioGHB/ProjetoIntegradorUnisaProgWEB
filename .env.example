# Opcional: copie para .env.local. Para testar localmente não precisa deste arquivo.
APP_ENV=development
# Uma chave privada fixa preserva sessões entre reinícios. Sem ela, localmente
# uma chave aleatória é criada a cada inicialização, encerrando sessões antigas.
SECRET_KEY=
# Somente na hospedagem: APP_ENV=production e URL do PostgreSQL com TLS.
DATABASE_URL=
# Na hospedagem, hosts separados por vírgula; no Render o domínio é detectado.
TRUSTED_HOSTS=
# Somente para permitir o comando preparar-demo em um banco de demonstração online.
DEMO_MODE=false
